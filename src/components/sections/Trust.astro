---
// B-F020 (top20.ua rating, named source) and B-F009 (the clinic's own figure, marked as such). Proof in the category's form.
---
<section id="trust" class="trust layer layer--l3" aria-label="Оцінка пацієнтів">
  <div class="bleed trust__grid">
    <div class="trust__body">
      <p class="trust__phrase">4,8 — оцінка Dermline на top20.ua за 62 відгуками</p>
      <p class="trust__note">8576+ задоволених клієнтів — за даними клініки</p>
    </div>
  </div>
</section>
<style>
  .trust { padding-top: var(--space-section); }
  .trust__body { position: relative; display: grid; gap: var(--space-3); padding-left: var(--space-4); padding-bottom: var(--space-6); }
  .trust__body::before { content: ""; position: absolute; left: 0; top: var(--space-1); bottom: 0; width: var(--line-w); background: var(--line); }
  .trust__phrase { font-family: var(--font-display); font-weight: var(--weight-light); font-size: var(--text-section); line-height: var(--leading-tight); max-width: 22ch; overflow-wrap: break-word; min-width: 0; }
  .trust__note { color: var(--ink-2); }
  @media (min-width: 900px) {
    .trust__body { grid-column: col-start 1 / span 10; padding-left: var(--space-5); }
  }
</style>
