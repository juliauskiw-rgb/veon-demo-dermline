---
// B-F003: the clinic in the centre of Lviv. Real interiors from the client's site (the facade already opens the page).
import { Picture } from "astro:assets";
import Icon from "../Icon.astro";
import FutureLink from "../FutureLink.astro";
import reception from "../../assets/clinic-reception.jpg";
import cabinet from "../../assets/clinic-cabinet.jpg";
import corridor from "../../assets/clinic-corridor.jpg";
import { clinic, NOTE } from "../../data/clinic";
---
<section id="clinic" class="clinic layer layer--l2" aria-labelledby="clinic-title">
  <div class="bleed clinic__grid">
    <figure class="clinic__wide" data-reveal>
      <Picture src={reception} formats={["avif", "webp"]} widths={[480, 800, 1200, 1500]} sizes="100vw" alt="Рецепція клініки Dermline з вивіскою" loading="lazy" decoding="async" />
    </figure>
    <div class="clinic__text">
      <h2 id="clinic-title" class="section__title">Клініка на Тернопільській, 15</h2>
      <p class="clinic__address">Адреса: {clinic.address}.</p>
      <div class="clinic__links">
        <a class="tlink" href={clinic.map} rel="noopener" target="_blank"><Icon name="route" size={20} />Прокласти маршрут</a>
        <FutureLink note={NOTE}>Результати до/після</FutureLink>
      </div>
    </div>
    <figure class="clinic__small clinic__small--a" data-reveal>
      <Picture src={cabinet} formats={["avif", "webp"]} widths={[400, 700]} sizes="(min-width: 900px) 40vw, 100vw" alt="Кабінет апаратної косметології" loading="lazy" decoding="async" />
    </figure>
    <figure class="clinic__small clinic__small--b" data-reveal style="--reveal-delay:120ms">
      <Picture src={corridor} formats={["avif", "webp"]} widths={[400, 700]} sizes="(min-width: 900px) 40vw, 100vw" alt="Хол клініки" loading="lazy" decoding="async" />
    </figure>
  </div>
</section>
<style>
  .clinic { padding-bottom: var(--space-section); }
  .clinic__grid { row-gap: var(--space-4); }
  .clinic figure { margin: 0; }
  .clinic :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .clinic__wide { grid-column: full-start / full-end; aspect-ratio: 4 / 5; overflow: hidden; }
  .clinic__text { display: grid; gap: var(--space-3); }
  .clinic__address { font-family: var(--font-display); font-size: var(--text-item); line-height: var(--leading-head); max-width: 30ch; }
  .clinic__links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-4); }
  .clinic__small { aspect-ratio: 3 / 2; overflow: hidden; }
  .clinic__small--b { display: none; }
  :global(.js) .clinic figure[data-reveal]:not(.is-visible) { transform: translateY(16px); }
  @media (min-width: 900px) {
    .clinic__grid { row-gap: 0; }
    .clinic__wide { aspect-ratio: 16 / 9; max-height: 760px; }
    .clinic__text { grid-column: col-start 1 / span 6; padding-top: var(--space-5); }
    .clinic__small--a { grid-column: col-start 8 / span 5; margin-top: calc(-1 * var(--space-6)); }
    .clinic__small--b { display: block; grid-column: col-start 2 / span 5; margin-top: var(--space-5); }
  }
</style>
