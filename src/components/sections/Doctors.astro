---
// B-F008: two key doctors by name and role (R-006), real photos from the client's site.
import { Picture } from "astro:assets";
import FutureLink from "../FutureLink.astro";
import halyna from "../../assets/doctor-halyna-myronovych.jpg";
import volodymyr from "../../assets/doctor-volodymyr-myronovych.jpg";
import { NOTE } from "../../data/clinic";
const doctors = [
  { img: halyna, name: "Галина Миронович", role: "Головний лікар, дерматолог, косметолог", cls: "doc--lead" },
  { img: volodymyr, name: "Володимир Миронович", role: "Пластичний хірург, хірург-онколог", cls: "doc--second" },
];
---
<section id="doctors" class="doctors layer layer--l1 section" data-rec="R-006,S-R013" aria-labelledby="doctors-title">
  <div class="doctors__grid bleed">
    <h2 id="doctors-title" class="section__title doctors__title">Лікарі</h2>
    {doctors.map((d, i) => (
      <figure class:list={["doc", d.cls]} data-reveal style={`--reveal-delay:${i * 120}ms`}>
        <div class="doc__frame">
          <Picture src={d.img} formats={["avif", "webp"]} widths={[360, 600]} sizes="(min-width: 900px) 40vw, 100vw" alt={`${d.name}, ${d.role.toLowerCase()}`} loading="lazy" decoding="async" />
        </div>
        <figcaption>
          <h3 class="doc__name">{d.name}</h3>
          <p class="doc__role muted">{d.role}</p>
        </figcaption>
      </figure>
    ))}
    <div class="doctors__team">
      <p>У команді 9 фахівців: дерматологи, дитячий дерматолог-трихолог, фахівці з лазерної епіляції, масажисти.</p>
      <FutureLink note={NOTE}>Уся команда</FutureLink>
    </div>
  </div>
</section>
<style>
  .doctors__grid { row-gap: var(--space-5); }
  .doc { margin: 0; display: grid; gap: var(--space-3); }
  .doc__frame { overflow: hidden; aspect-ratio: 4 / 5; background: var(--color-l0); }
  .doc__frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; transition: transform 400ms var(--ease-out); }
  .doc:hover .doc__frame :global(img) { transform: scale(1.03); }
  .doc__name { font-size: var(--text-title); }
  .doc__role { margin-top: var(--space-1); }
  .doctors__team { display: grid; gap: var(--space-2); justify-items: start; max-width: 52ch; }
  @media (min-width: 900px) {
    .doctors__title { grid-column: col-start 1 / span 12; }
    .doc--lead { grid-column: col-start 2 / span 5; grid-row: 2 / span 2; }
    .doc--second { grid-column: col-start 8 / span 4; grid-row: 2; margin-top: calc(var(--space-6) + var(--space-2)); }
    .doctors__team { grid-column: col-start 8 / span 5; grid-row: 3; align-self: end; }
    .doc__name { font-size: var(--text-name); }
  }
  @media (hover: none) { .doc:hover .doc__frame :global(img) { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .doc:hover .doc__frame :global(img) { transform: none; } }
</style>
