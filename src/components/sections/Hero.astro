---
import { Picture } from "astro:assets";
import Button from "../Button.astro";
import facade from "../../assets/clinic-facade.jpg";
import { clinic } from "../../data/clinic";
---
<section id="hero" class="hero layer" data-rec="R-002,GA-R002,MA-R006">
  <div class="hero__grid bleed">
    <h1 class="hero__title">Медичний центр естетичної косметології та дерматології у Львові</h1>
    <div class="hero__actions">
      <Button href="#contacts" class="hero__cta">Записатися на консультацію</Button>
      <a class="tlink hero__phone" href={clinic.phone.href}>{clinic.phone.display}</a>
    </div>
    <div class="hero__line" aria-hidden="true"></div>
    <p class="hero__lede">Лікарі-дерматологи та пластичний хірург, обладнання PicoSure, HALO, Ultraformer, VISIA. Запис починається з консультації лікаря.</p>
    <ul class="hero__facts" aria-label="Коротко про клініку">
      <li>Ліцензія МОЗ України</li>
      <li>{clinic.address}</li>
      <li>Пн–Сб 9:00–21:00, Нд 11:00–18:00, прийом за записом</li>
    </ul>
  </div>
</section>
<div class="hero-photo layer bleed">
  <figure class="hero__photo">
    <Picture src={facade} formats={["avif", "webp"]} widths={[480, 800, 1200, 1500]} sizes="(min-width: 900px) 80vw, 100vw" alt="Особняк клініки Dermline на вулиці Тернопільській, 15 у Львові" loading="eager" fetchpriority="high" />
  </figure>
</div>
<style>
  .hero { padding-top: var(--space-4); padding-bottom: var(--space-4); }
  .hero__grid { row-gap: var(--space-3); }
  .hero__title { font-size: var(--text-hero); font-weight: var(--weight-light); line-height: var(--leading-tight); letter-spacing: -0.01em; }
  .hero__actions { display: grid; gap: var(--space-1); justify-items: start; }
  .hero__actions :global(.hero__cta) { width: 100%; }
  .hero__line {
    grid-column: content-start / full-end; height: var(--line-w); background: var(--line);
    transform-origin: left center; animation: draw-line var(--dur-line) var(--ease-out) both;
  }
  .hero__lede { color: var(--ink-2); max-width: 46ch; }
  .hero__phone { white-space: nowrap; }
  .hero__facts { display: grid; gap: var(--space-0); font-size: var(--text-small); }
  .hero__photo { grid-column: content-start / full-end; margin: 0; }
  .hero__photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 45%; }

  @media (min-width: 900px) {
    .hero { padding-top: var(--space-5); padding-bottom: var(--space-5); }
    .hero__grid { row-gap: 0; }
    .hero__title { grid-column: col-start 1 / span 10; grid-row: 1; padding-bottom: var(--space-4); }
    .hero__line { grid-row: 2; }
    .hero__lede { grid-column: col-start 1 / span 5; grid-row: 3; padding-top: var(--space-4); }
    .hero__actions { grid-column: col-start 1 / span 7; grid-row: 4; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); padding-top: var(--space-3); }
    .hero__actions :global(.hero__cta) { width: auto; }
    .hero__facts { grid-column: col-start 8 / span 5; grid-row: 3 / span 2; align-self: start; padding-top: var(--space-4); gap: var(--space-1); font-size: var(--text-body); }
    .hero__photo { grid-column: col-start 3 / full-end; }
    .hero__photo :global(img) { aspect-ratio: 21 / 9; object-position: 50% 40%; }
  }

  @keyframes draw-line { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @media (prefers-reduced-motion: reduce) { .hero__line { animation: none; transform: none; } }
</style>
