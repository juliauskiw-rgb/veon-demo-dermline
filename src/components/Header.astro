---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import FutureLink from "./FutureLink.astro";
import Channels from "./Channels.astro";
import { clinic, nav, NOTE } from "../data/clinic";
---
<header class="header layer">
  <div class="header__in container">
    <a class="header__logo" href="#top" aria-label="Dermline, на початок сторінки"><Logo /></a>
    <nav class="header__nav" aria-label="Основне меню">
      <ul>
        {nav.map((item) => (
          <li>{"href" in item ? <a class="nav-link" href={item.href}>{item.label}</a> : <FutureLink note={NOTE} class="nav-future">{item.label}</FutureLink>}</li>
        ))}
      </ul>
    </nav>
    <div class="header__actions">
      <a class="header__phone" href={clinic.phone.href} data-rec="R-002"><Icon name="phone" size={20} /><span class="header__phone-num">{clinic.phone.display}</span><span class="visually-hidden header__phone-sr">Подзвонити {clinic.phone.display}</span></a>
      <a class="header__cta" href="#contacts">Записатися</a>
      <button class="header__menu" type="button" popovertarget="menu" aria-label="Меню"><Icon name="menu" /></button>
    </div>
  </div>
</header>
<div id="menu" class="menu layer layer--l3" popover>
  <div class="menu__top">
    <span class="menu__title">Меню</span>
    <button class="menu__close" type="button" popovertarget="menu" popovertargetaction="hide" aria-label="Закрити меню"><Icon name="close" /></button>
  </div>
  <nav aria-label="Мобільне меню">
    <ul class="menu__list">
      {nav.map((item) => (
        <li>{"href" in item ? <a class="menu__link" href={item.href}>{item.label}</a> : <FutureLink note={NOTE} class="menu__future">{item.label}</FutureLink>}</li>
      ))}
    </ul>
  </nav>
  <div class="menu__foot">
    <p class="menu__hint">Запис на консультацію</p>
    <Channels variant="menu" />
  </div>
</div>
<script>
  // Close the popover menu after choosing an anchor; mark the active anchor in the nav.
  const menu = document.getElementById("menu") as (HTMLElement & { hidePopover?: () => void }) | null;
  menu?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => a.addEventListener("click", () => menu.hidePopover?.()));
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav-link"));
  const targets = links.map((l) => document.querySelector<HTMLElement>(l.getAttribute("href") || "")).filter(Boolean) as HTMLElement[];
  if ("IntersectionObserver" in window && targets.length) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((l) => l.toggleAttribute("aria-current", l.getAttribute("href") === `#${e.target.id}`));
      }
    }, { rootMargin: "-45% 0px -50% 0px" });
    targets.forEach((t) => io.observe(t));
  }
  // FutureLink: a tap shows the note for a moment (touch has no hover).
  document.querySelectorAll<HTMLElement>(".future-link").forEach((el) => {
    let t = 0;
    el.addEventListener("click", () => { el.classList.add("is-tapped"); clearTimeout(t); t = window.setTimeout(() => el.classList.remove("is-tapped"), 1800); });
  });
</script>
<style>
  .header { position: sticky; top: 0; z-index: var(--z-header); border-bottom: var(--hairline) solid var(--color-l1); }
  .header__in { display: flex; align-items: center; gap: var(--space-3); min-height: var(--header-h); }
  .header__logo { display: block; width: 104px; flex: none; color: var(--ink); }
  .header__nav { display: none; margin-inline: auto; }
  .header__nav ul { display: flex; gap: var(--space-3); }
  .nav-link { position: relative; display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; font-size: var(--text-small); }
  .nav-link::after { content: ""; position: absolute; left: 0; right: 0; bottom: var(--space-1); height: var(--line-w); background: var(--line); transform: scaleX(0); transform-origin: left; transition: transform var(--dur-fast) var(--ease-out); }
  .nav-link:hover::after, .nav-link[aria-current]::after { transform: scaleX(1); }
  .nav-link:active { opacity: .8; }
  :global(.nav-future) { font-size: var(--text-small); }
  .header__actions { display: flex; align-items: center; gap: var(--space-1); margin-left: auto; }
  .header__phone { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-1); min-width: 44px; min-height: 44px; color: var(--ink); text-decoration: none; font-weight: var(--weight-medium); font-size: var(--text-small); border: var(--hairline) solid var(--color-l1); border-radius: var(--radius); }
  .header__phone:hover { border-color: var(--ink-2); }
  .header__phone:active { opacity: .8; }
  .header__phone-num { display: none; }
  .header__cta { display: none; align-items: center; min-height: 44px; padding: 0 var(--space-3); background: var(--ink); color: var(--paper); border-radius: var(--radius); text-decoration: none; font-weight: var(--weight-medium); font-size: var(--text-small); transition: transform var(--dur-press) var(--ease-out), opacity var(--dur-fast) var(--ease-out); }
  .header__cta:hover { opacity: .88; }
  .header__cta:active { transform: scale(.98); }
  .header__menu { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; background: none; border: 0; cursor: pointer; color: var(--ink); }
  .header__menu:hover { color: var(--line); }
  .header__menu:active { transform: scale(.96); }

  @media (min-width: 1100px) {
    .header__logo { width: 124px; }
    .header__nav { display: block; }
    .header__menu { display: none; }
    .header__cta { display: inline-flex; }
    .header__phone { border: 0; }
  }
  @media (min-width: 1240px) {
    .header__phone-num { display: inline; }
    .header__phone-sr { display: none; }
    .header__phone .icon { display: none; }
    .header__actions { gap: var(--space-3); }
  }

  .menu { inset: 0 0 0 auto; width: min(100%, 420px); height: 100dvh; max-height: none; margin: 0; padding: var(--space-2) var(--space) var(--space-4); border: 0; flex-direction: column; gap: var(--space-4); overflow-y: auto; }
  .menu:popover-open { display: flex; }
  .menu::backdrop { background: var(--color-l4); opacity: .6; }
  .menu__top { display: flex; align-items: center; justify-content: space-between; min-height: 48px; }
  .menu__title { color: var(--ink-2); font-size: var(--text-small); }
  .menu__close { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; background: none; border: 0; color: var(--ink); cursor: pointer; }
  .menu__close:active { transform: scale(.96); }
  .menu__list { display: grid; gap: var(--space-0); }
  .menu__link { display: flex; align-items: center; min-height: 52px; font-family: var(--font-display); font-weight: var(--weight-light); font-size: var(--text-title); text-decoration: none; }
  .menu__link:hover { color: var(--line); }
  .menu__link:active { opacity: .8; }
  :global(.menu__future) { min-height: 52px; font-family: var(--font-display); font-weight: var(--weight-light); font-size: var(--text-title); }
  .menu__foot { margin-top: auto; display: grid; gap: var(--space-2); }
  .menu__hint { color: var(--ink-2); font-size: var(--text-small); }
  @media (prefers-reduced-motion: reduce) { .header__cta:active, .header__menu:active, .menu__close:active { transform: none; } .nav-link::after { transition: none; } }
</style>
